# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m vaani_agent.cli --list-models` to see what your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite

# development | production. Production refuses to start with the defaults below.
APP_ENV=development

# Shared secret between the agent workers and the API.
AGENT_API_KEY=dev-agent-key
API_BASE_URL=http://localhost:8000

# vaani_app is subject to row-level security; vaani_admin owns the tables.
DATABASE_URL=postgresql+psycopg://vaani_app:vaani_app@localhost:5435/vaani
ADMIN_DATABASE_URL=postgresql+psycopg://vaani_admin:vaani_admin@localhost:5435/vaani

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp).
# Leave WHATSAPP_ACCESS_TOKEN empty to log replies instead of sending them.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Sarvam speech-to-text for WhatsApp voice notes (https://dashboard.sarvam.ai).
# Without a key, voice notes get a "please type" reply.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix

# Real-time voice (LiveKit). These defaults match `docker compose up -d livekit`.
# For LiveKit Cloud (free tier), paste your project's URL, key and secret instead.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Bulbul voices are per language; see vaani_agent/config.py to change them.
SARVAM_TTS_MODEL=bulbul:v4-flash
VOICE_MAX_CALL_SECONDS=300

# Dashboard sessions. In production: a long random secret, and COOKIE_SECURE=true.
DASHBOARD_JWT_SECRET=dev-only-dashboard-secret-change-me-0123456789
COOKIE_SECURE=false

# Optional error tracking (https://sentry.io). Request bodies and personal data are never sent.
SENTRY_DSN=
